# Copy to .env
PORT=5000
# Local Mongo OR Atlas (paste the mongodb+srv:// string from Atlas → Connect → Drivers):
# MONGO_URI=mongodb+srv://<user>:<encoded-password>@cluster0.xxxxx.mongodb.net/spnt
MONGO_URI=mongodb://127.0.0.1:27017/spnt
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:4200,http://127.0.0.1:4200
